# runs and their cache
runs/
graded/
.cache/
*.graded.jsonl
placement.json

# secrets — never commit these
.env
.env.*
*.key

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# os
.DS_Store

# gpqa ships as a manifest, not as text (author-gated upstream).
# `python -m nocot.fetch_gpqa` rebuilds and byte-verifies it.
data/ncri/gpqa.jsonl

# The item banks and the rows ship INSIDE data/nocot_data.zip, never
# unpacked in git. Unpacking is how you USE them
# (`unzip -P <password> data/nocot_data.zip`); committing the unpacked copy
# would ship every item twice and defeat the archive's crawler barrier.
# data/rows/README.md is tracked and, being tracked, is unaffected.
data/ncri/
data/knowledge/
data/extras/
data/diagnostics/
data/rows/*.jsonl
data/rows/prompts.json
data/rows/ROWS_INDEX.json
data/CANARY.txt
